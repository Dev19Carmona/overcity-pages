# Solo para `npm run db:copy` (scripts/copy-catalog-to-local.ts).
# Copia este archivo a .env.copy.local y completa los valores ALLÍ, no aquí: esta plantilla sí se sube
# a git. No subas .env.copy.local.

# Origen: el proyecto de producción. El script solo lo lee.
# Project Settings → API en el panel de Supabase.
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=

# Destino: la base local. Los valores salen de `npx supabase status` (URL de la API y la clave
# `service_role` o `secret`).
TARGET_SUPABASE_URL=http://127.0.0.1:54321
TARGET_SUPABASE_SERVICE_ROLE_KEY=
