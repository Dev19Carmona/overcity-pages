# Copia este archivo a .env.local y completa los valores. No subas .env.local a git.

# Clave para entrar a /admin.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Upstash Redis (integración de Vercel). Guarda el contenido y el límite de intentos.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (integración de Vercel). Guarda el logo, el fondo y la música.
BLOB_READ_WRITE_TOKEN=

# Supabase (SPEC 12). Guarda el catálogo (Postgres) y las fotos de diseños (Storage).
# Solo servidor: nunca con prefijo NEXT_PUBLIC_. Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
