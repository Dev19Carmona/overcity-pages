# Copia este archivo a .env.local y completa los valores. No subas .env.local a git.

# Login con SSO de base-template (SPEC 13). Si falta cualquiera, el login responde `not_configured`.
# URL pública canónica de Overcity (https://...). Se usa para la redirect_uri; nunca se deriva de Host.
APP_URL=
# URL pública de base-template (SSO_ISSUER de allá).
AUTH_ISSUER=
# client_id y client_secret del registro en /platform/client-apps (el secreto se muestra una sola vez).
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# UUID de la empresa Overcity en base-template.
AUTH_TENANT_ID=
# Mínimo 32 caracteres. Cifra la cookie overcity_oidc y el refresh token en Redis.
# Genera uno con: openssl rand -base64 32
AUTH_SESSION_SECRET=

# Retiradas al final del corte (SPEC 13, paso 5). Mantenerlas hasta verificar el SSO en producción:
# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Upstash Redis (integración de Vercel). Guarda el contenido y el límite de intentos.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (integración de Vercel). Guarda el logo, el fondo y la música.
BLOB_READ_WRITE_TOKEN=

# Supabase (SPEC 12). Guarda el catálogo (Postgres) y las fotos de diseños (Storage).
# Solo servidor: nunca con prefijo NEXT_PUBLIC_. Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
